apiVersion: apps/v1
kind: Deployment
metadata:
  name: my-ag-ui-app-modified
  namespace: default
spec:
  replicas: 3
  selector:
    matchLabels:
      app: my-ag-ui-app
  template:
    metadata:
      labels:
        app: my-ag-ui-app
    spec:
      containers:
      - name: my-ag-ui-app
        image: my-ag-ui-app:modified
        ports:
        - containerPort: 8080
