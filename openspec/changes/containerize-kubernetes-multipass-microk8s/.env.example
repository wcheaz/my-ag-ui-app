# Environment variables example for my-ag-ui-app
# Copy this file to .env and fill in your actual values
# Never commit .env file with real secrets to version control

# ================================================
# Application Configuration
# ================================================

# Node.js/Next.js Configuration
NODE_ENV=production                # Set to "development" for local development
PORT=3000                          # Application port (Next.js default)

# ================================================
# OpenAI Configuration (Required)
# ================================================

# Get these values from your OpenAI API dashboard
OPENAI_API_KEY=sk-your-openai-api-key-here  # Your OpenAI API key (starts with "sk-")
OPENAI_BASE_URL=https://api.openai.com/v1    # OpenAI API endpoint URL
OPENAI_MODEL=gpt-4                           # Default OpenAI model to use

# ================================================
# LLM Configuration (Required)
# ================================================

# Token and context limits for LLM responses
LLM_MAX_TOKENS=4096                          # Maximum tokens in LLM responses
LLM_CONTEXT_WINDOW=8192                      # Model context window size
EMBEDDING_MODEL=text-embedding-ada-002      # Model for text embeddings

# ================================================
# Logging Configuration (Conditional)
# ================================================

# Logfire logging (optional - remove if not using Logfire)
LOGFIRE_TOKEN=your-logfire-token-here       # Your Logfire authentication token

# ================================================
# Instructions
# ================================================
#
# 1. Copy this file to .env: cp .env.example .env
# 2. Replace placeholder values with your actual values
# 3. Keep your .env file secure and never commit it to git
# 4. For production deployment, these variables will be injected via Kubernetes secrets
#
# Required variables for the application to start:
# - NODE_ENV
# - PORT
# - OPENAI_API_KEY
# - OPENAI_BASE_URL
# - OPENAI_MODEL
# - LLM_MAX_TOKENS
# - LLM_CONTEXT_WINDOW
# - EMBEDDING_MODEL
#
# Optional variables:
# - LOGFIRE_TOKEN (only if using Logfire logging)
#