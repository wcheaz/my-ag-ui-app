# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Procurement Agent Configuration
LLM_MAX_TOKENS=
LLM_CONTEXT_WINDOW=
EMBEDDING_MODEL=
AGENT_URL=

# Confidence Gap Thresholds (JSON)
# Controls when multi-match components auto-resolve instead of asking the user.
# Format: {"component_key": {"gap_ratio": float, "min_top_score": float}, ...}
# gap_ratio: minimum (top_score - second_score) / top_score to auto-resolve
# min_top_score: minimum score the top match must have to auto-resolve
# Lower gap_ratio = more confident (auto-resolves more aggressively)
# Omit to use defaults (size_category=0.3, quality_grade=0.6, others=0.5)
COMPONENT_CONFIDENCE_THRESHOLDS=

# Logging Configuration
LOGFIRE_TOKEN=
